<!--
  Build-environment fix: take the whole BCL from the game, not from .NET Framework 4.8.

  Mod.props targets net48 and references the game's Unity mscorlib by full path
  (CSII_MSCORLIBPATH). But CS2's assemblies are built against .NET Standard 2.1, and Carto's
  own source uses 2.1-only APIs (System.Index for the `^1` operator, Math.Cbrt). Those do not
  exist in the .NET Framework 4.8 reference assemblies.

  With the SDK's implicit framework references left on, assembly resolution hits:

      Encountered conflict between 'Reference:...\Cities2_Data\Managed\mscorlib.dll'
      and 'Platform:mscorlib.dll'.

  and the platform one wins, so the compile fails with CS0518/CS0656 on System.Index and
  CS0117 on Math.Cbrt. Note the game's mscorlib is file version 4.6.57.0 — *lower* than a real
  4.8 targeting pack's — so installing the .NET Framework 4.8 Developer Pack does not resolve
  the conflict in the game's favour either.

  Turning implicit framework references off lets the game's mscorlib through, but also drops
  System / System.Core / System.Data / System.Xml / netstandard, so those are re-added by
  simple name. They resolve out of $(ManagedPath), which Mod.props already appends to
  AssemblySearchPaths — i.e. the same Unity BCL the game itself runs on, which is what a mod
  should compile against.

  Declared here rather than in Carto.csproj so the project file stays identical to upstream
  Carto and merges cleanly. Directory.Build.props is imported before the project body, so
  Carto.csproj's `<Reference Update="System" ...>` items find these and apply Private=False.
-->
<Project>

  <PropertyGroup>
    <!--
      Keep the mod's compile glob out of tools/. Carto.csproj is SDK-style, so it sweeps up
      every .cs under the repo root; tools/decomp is a separate net8.0 console app and compiling
      it into a net48 mod fails on the whole System.Reflection.Metadata surface.

      This has to be DefaultItemExcludes rather than an <ItemGroup><Compile Remove="tools\**"/>.
      Directory.Build.props is imported before the project body, i.e. before Sdk.props brings in
      the default globs, so there are no Compile items to remove yet. DefaultItemExcludes is a
      property, and the globs read it when they are finally expanded.
    -->
    <!--
      ...and out of the Python half's build outputs. `AssemblySearchPaths` puts
      {CandidateAssemblyFiles} FIRST, and CandidateAssemblyFiles is fed by the SDK's default
      None/Content globs — so every .dll under dist/, build/ and site/ was a candidate the
      reference resolver preferred over both the HintPath and the game's Managed folder. That is
      how `netstandard` came to resolve out of `dist/cs2beamng/_internal/pythonnet/runtime/`.
      (Found by refactor Phase 0, 2026-08-21.)
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tools\**;tests\**;dist\**;build\**;site\**;apps\**;packaging\**</DefaultItemExcludes>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <!--
      Also required. For a net48 target the SDK restores Microsoft.NETFramework.ReferenceAssemblies,
      whose own build props point FrameworkPathOverride at the 4.8 reference assemblies — so the
      4.8 BCL comes back in through the package even with implicit framework references off.
    -->
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <!--
      Analyzers, added by refactor Phase 0. Before this the producer had NO automated check of
      any kind: ci.yml did not list Systems/, IO/ or Domain/ in its `paths:` filter, so a C#
      change could not fail anything, including compilation.

      The build is warning-clean today (verified on 5b7e212, 0 warnings), which is what makes
      TreatWarningsAsErrors safe to switch on now rather than "one day". Which diagnostics are
      warnings is decided in .editorconfig, per file, so upstream Carto stays exempt from the
      refactor's rules without being exempt from compiling.

      Nullable stays off. Turning it on project-wide would report thousands of findings across
      ~30k lines of upstream code the refactor is forbidden to touch, and it cannot be scoped by
      .editorconfig the way a diagnostic can. Fork files opt in one at a time with a
      `#nullable enable` at the top, which is a Phase 9/11 move as each file is split.
    -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Deployment writes into the game's mods folder; a stale-file warning there is not ours. -->
    <WarningsNotAsErrors>MSB3277;NU1701</WarningsNotAsErrors>
    <!--
      With that package gone, MSBuild has no reference-assembly directory at all and fails with
      MSB3644. Point it at the game's Managed folder, which is the BCL the game actually runs
      on. Read straight from CSII_MANAGEDPATH rather than Mod.props' $(ManagedPath): Mod.props
      is imported from the project body, i.e. after this file.
    -->
    <FrameworkPathOverride Condition="'$(FrameworkPathOverride)' == ''">$([System.Environment]::GetEnvironmentVariable('CSII_MANAGEDPATH', 'EnvironmentVariableTarget.User'))</FrameworkPathOverride>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Deliberately no `mscorlib` entry: Mod.props already references it by full path via
      CSII_MSCORLIBPATH, which is what pins it to the game's copy. Adding it here by simple
      name resolves it out of the .NET Framework reference assemblies instead and puts the
      System.Index / Math.Cbrt failures straight back.
    -->
    <!--
      By FULL PATH, not by simple name. Resolved by name, MSBuild searched the repo and found
      `dist/cs2beamng/_internal/pythonnet/runtime/netstandard.dll` — a PyInstaller output of the
      Python half of this repo — and compiled the mod against pythonnet's facade instead of the
      game's. It built, which is why nobody noticed; it would have broken the day `dist/` was
      cleaned or rebuilt against a different pythonnet. (Found by refactor Phase 0, 2026-08-21.)
    -->
    <Reference Include="netstandard">
      <HintPath>$(FrameworkPathOverride)\netstandard.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System">
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Core">
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Data">
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Xml">
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
